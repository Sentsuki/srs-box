{
  "ruleset_version": 4,
  "output": {
    "srs": {
      "dir": "output/srs",
      "branch": "srs_release"
    },
    "json": {
      "dir": "output/json",
      "branch": "json_release"
    }
  },
  "fetch": {
    "concurrency": 16,
    "timeout": "30s",
    "retries": 3
  },
  "geosite": {
    "repo": "v2fly/domain-list-community",
    "normalize": "lenient"
  },
  "rulesets": {
    "normal-ai": {
      "sources": [
        "https://github.com/viewer12/OverseasAI.list/raw/refs/heads/main/rule/Singbox/OverseasAI/OverseasAI.json"
      ],
      "files": [
        "data/Apple_Intelligence.json"
      ],
      "geosite": [
        "category-ai-!cn"
      ]
    },
    "apple-api": {
      "sources": [
        "https://github.com/Elysian-Realme/FuGfConfig/raw/refs/heads/main/ConfigFile/sing-box/Apple/api-domain.list"
      ]
    },
    "apple-api-ip": {
      "sources": [
        "https://github.com/Elysian-Realme/FuGfConfig/raw/refs/heads/main/ConfigFile/sing-box/Apple/api-ip.list"
      ]
    },
    "apple-cdn": {
      "sources": [
        "https://github.com/Elysian-Realme/FuGfConfig/raw/refs/heads/main/ConfigFile/sing-box/Apple/cdn-domain.list"
      ]
    },
    "apple-nocn-cdn": {
      "sources": [
        "https://github.com/Elysian-Realme/FuGfConfig/raw/refs/heads/main/ConfigFile/sing-box/Apple/no-cn-cdn-domain.list"
      ]
    },
    "apple-rules": {
      "sources": [
        "https://github.com/Elysian-Realme/FuGfConfig/raw/refs/heads/main/ConfigFile/sing-box/Apple/domain.list"
      ]
    },
    "apple-update": {
      "sources": [
        "https://github.com/Elysian-Realme/FuGfConfig/raw/refs/heads/main/ConfigFile/sing-box/Apple/update-domain.list"
      ]
    },
    "block-ads": {
      "sources": [
        "https://github.com/TG-Twilight/AWAvenue-Ads-Rule/raw/refs/heads/main/Filters/AWAvenue-Ads-Rule-Singbox.json"
      ],
      "exclude": {
        "geosite": [
          "google@ads"
        ]
      }
    },
    "block-dns": {
      "sources": [
        "https://raw.githubusercontent.com/VirgilClyne/GetSomeFries/main/ruleset/HTTPDNS.Block.yaml"
      ]
    },
    "cn-ip": {
      "format": "cidr",
      "aggregate": true,
      "sources": [
        "https://github.com/gaoyifan/china-operator-ip/raw/refs/heads/ip-lists/chinanet46.txt",
        "https://github.com/gaoyifan/china-operator-ip/raw/refs/heads/ip-lists/cmcc46.txt",
        "https://github.com/gaoyifan/china-operator-ip/raw/refs/heads/ip-lists/unicom46.txt",
        "https://github.com/gaoyifan/china-operator-ip/raw/refs/heads/ip-lists/cernet46.txt",
        "https://github.com/gaoyifan/china-operator-ip/raw/refs/heads/ip-lists/cstnet46.txt",
        "https://github.com/gaoyifan/china-operator-ip/raw/refs/heads/ip-lists/drpeng46.txt"
      ]
    },
    "riot": {
      "sources": [
        "https://github.com/LM-Firefly/Rules/raw/refs/heads/master/Game/Riot.list"
      ]
    },
    "skk-download": {
      "sources": [
        "https://ruleset.skk.moe/sing-box/domainset/download.json",
        "https://ruleset.skk.moe/sing-box/non_ip/download.json"
      ]
    },
    "skk-microsoft-cdn": {
      "sources": [
        "https://ruleset.skk.moe/sing-box/non_ip/microsoft_cdn.json"
      ]
    },
    "telegram-ip": {
      "format": "cidr",
      "aggregate": true,
      "sources": [
        "https://core.telegram.org/resources/cidr.txt"
      ]
    },
    "geosite-cn": {
      "geosite": [
        "geolocation-cn",
        "category-*-cn",
        "category-*@cn"
      ],
      "inline": [
        "DOMAIN-SUFFIX,.cn"
      ]
    },
    "geosite-google": {
      "geosite": [
        "google"
      ],
      "inline": [
        "DOMAIN-KEYWORD,google"
      ],
      "exclude": {
        "geosite": [
          "youtube"
        ]
      }
    },
    "geosite-youtube": {
      "geosite": [
        "youtube"
      ]
    },
    "geosite-reddit": {
      "geosite": [
        "reddit"
      ]
    },
    "geosite-amazon": {
      "geosite": [
        "amazon"
      ]
    },
    "geosite-telegram": {
      "geosite": [
        "telegram"
      ]
    },
    "geosite-line": {
      "geosite": [
        "line"
      ]
    },
    "geosite-epicgames": {
      "geosite": [
        "epicgames"
      ]
    },
    "geosite-steam": {
      "geosite": [
        "steam"
      ]
    },
    "geosite-xbox": {
      "geosite": [
        "xbox"
      ]
    },
    "geosite-paypal": {
      "geosite": [
        "paypal"
      ]
    },
    "geosite-oracle": {
      "geosite": [
        "oracle"
      ]
    },
    "geosite-microsoft": {
      "geosite": [
        "microsoft"
      ]
    },
    "geosite-protonmail": {
      "geosite": [
        "protonmail"
      ]
    },
    "geosite-nvidia": {
      "geosite": [
        "nvidia"
      ]
    },
    "geosite-x": {
      "geosite": [
        "x"
      ]
    },
    "geosite-meta": {
      "geosite": [
        "meta"
      ]
    },
    "geosite-wikimedia": {
      "geosite": [
        "wikimedia"
      ]
    },
    "geosite-spotify": {
      "geosite": [
        "spotify"
      ]
    }
  }
}