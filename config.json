{
  "schema": 1,
  "ruleset_version": 4,
  "sing_box": {
    "version": "1.14.0",
    "platform": "linux-amd64"
  },
  "output": {
    "json_dir": "output/json",
    "srs_dir": "output/srs"
  },
  "fetch": {
    "concurrency": 8,
    "timeout": 30,
    "retries": 3
  },
  "rulesets": {
    "apple-ai": [
      "https://github.com/Sentsuki/srs-box/raw/refs/heads/main/data/Apple_Intelligence.json"
    ],
    "block-ads": [
      "https://github.com/TG-Twilight/AWAvenue-Ads-Rule/raw/refs/heads/main/Filters/AWAvenue-Ads-Rule-Singbox.json"
    ],
    "cn-ip": {
      "format": "cidr",
      "aggregate": true,
      "base": "https://github.com/gaoyifan/china-operator-ip/raw/refs/heads/ip-lists/",
      "sources": [
        "chinanet46.txt",
        "cmcc46.txt",
        "unicom46.txt",
        "cernet46.txt",
        "cstnet46.txt",
        "drpeng46.txt"
      ]
    },
    "telegram-ip": {
      "format": "cidr",
      "aggregate": true,
      "sources": [
        "https://core.telegram.org/resources/cidr.txt"
      ]
    },
    "block-dns": {
      "format": "yaml",
      "sources": [
        "https://raw.githubusercontent.com/VirgilClyne/GetSomeFries/main/ruleset/HTTPDNS.Block.yaml"
      ]
    },
    "normal-ai": {
      "format": "text",
      "sources": [
        "https://raw.githubusercontent.com/viewer12/OverseasAI.list/main/rule/Clash/OverseasAI/OverseasAI.list"
      ]
    },
    "riot": {
      "format": "text",
      "sources": [
        "https://github.com/LM-Firefly/Rules/raw/refs/heads/master/Game/Riot.list"
      ]
    },
    "apple": {
      "base": "https://github.com/Elysian-Realme/FuGfConfig/raw/refs/heads/main/ConfigFile/sing-box/Apple/",
      "items": {
        "api": "api-domain.list",
        "api-ip": "api-ip.list",
        "cdn": "cdn-domain.list",
        "rules": "domain.list",
        "nocn-cdn": "no-cn-cdn-domain.list",
        "update": "update-domain.list"
      }
    },
    "skk": {
      "base": "https://ruleset.skk.moe/sing-box/",
      "items": {
        "apple-cdn": [
          "domainset/apple_cdn.json",
          "non_ip/apple_cdn.json"
        ],
        "cdn": [
          "domainset/cdn.json",
          "non_ip/cdn.json"
        ],
        "download": [
          "domainset/download.json",
          "non_ip/download.json"
        ],
        "game-download": "domainset/game-download.json",
        "icloud-private-relay": "domainset/icloud_private_relay.json",
        "reject": [
          "domainset/reject.json",
          "non_ip/reject.json"
        ],
        "reject-extra": "domainset/reject_extra.json",
        "speedtest": "domainset/speedtest.json",
        "ai": "non_ip/ai.json",
        "apple-cn": "non_ip/apple_cn.json",
        "apple-services": "non_ip/apple_services.json",
        "cloudmounter": "non_ip/cloudmounter.json",
        "direct": "non_ip/direct.json",
        "domestic": "non_ip/domestic.json",
        "gitlab": "non_ip/gitlab.json",
        "global": "non_ip/global.json",
        "lan": "non_ip/lan.json",
        "microsoft": "non_ip/microsoft.json",
        "microsoft-cdn": "non_ip/microsoft_cdn.json",
        "my-direct": "non_ip/my_direct.json",
        "my-git": "non_ip/my_git.json",
        "my-plus": "non_ip/my_plus.json",
        "my-proxy": "non_ip/my_proxy.json",
        "my-reject": "non_ip/my_reject.json",
        "my-us": "non_ip/my_us.json",
        "neteasemusic": "non_ip/neteasemusic.json",
        "reject-drop": "non_ip/reject-drop.json",
        "reject-no-drop": "non_ip/reject-no-drop.json",
        "reject-url-regex": "non_ip/reject-url-regex.json",
        "sogouinput": "non_ip/sogouinput.json",
        "stream": "non_ip/stream.json",
        "stream-biliintl": "non_ip/stream_biliintl.json",
        "stream-eu": "non_ip/stream_eu.json",
        "stream-hk": "non_ip/stream_hk.json",
        "stream-jp": "non_ip/stream_jp.json",
        "stream-kr": "non_ip/stream_kr.json",
        "stream-tw": "non_ip/stream_tw.json",
        "stream-us": "non_ip/stream_us.json",
        "telegram": "non_ip/telegram.json"
      }
    }
  }
}