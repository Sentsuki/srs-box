{
  "ruleset_version": 4,
  "output": {
    "srs": {
      "dir": "output/srs",
      "branch": "srs_release"
    },
    "json": {
      "dir": "output/json",
      "branch": "json_release"
    }
  },
  "fetch": {
    "concurrency": 16,
    "timeout": "30s",
    "retries": 3
  },
  "geosite": {
    "repo": "v2fly/domain-list-community",
    "normalize": "lenient"
  },
  "rulesets": {
    "adblock": {
      "sources": [
        "https://example.com/rules/adblock.json"
      ]
    },
    "adguard-filter": {
      "format": "adguard",
      "sources": [
        "https://example.com/rules/filters.txt"
      ]
    },
    "cn-domains": {
      "geosite": [
        "geolocation-cn",
        "category-*-cn"
      ]
    },
    "custom-composite": {
      "sources": [
        "https://example.com/rules/custom.list"
      ],
      "files": [
        "data/example-rules.json"
      ],
      "geosite": [
        "telegram"
      ],
      "inline": [
        "DOMAIN-SUFFIX,internal.example.com",
        "DOMAIN-KEYWORD,local"
      ]
    },
    "direct-cidr": {
      "format": "cidr",
      "aggregate": true,
      "sources": [
        "https://example.com/rules/china_ip.txt"
      ],
      "inline": [
        "192.168.0.0/16",
        "10.0.0.0/8"
      ]
    },
    "google-no-ads": {
      "geosite": [
        "google"
      ],
      "exclude": {
        "geosite": [
          "google@ads"
        ]
      }
    },
    "simple-shorthand": [
      "https://example.com/rules/proxy-list.json"
    ]
  }
}
